{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "jsx": "react-native",      // tell TS how to handle JSX
    "esModuleInterop": true     // allow default imports from CJS modules like react
  },
  "include": [
    "src",
    "declarations"
  ]
}
